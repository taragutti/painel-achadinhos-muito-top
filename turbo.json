{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", ".vinext/**"],
      "env": [
        "DATABASE_URL",
        "APP_URL",
        "VERCEL_PROJECT_PRODUCTION_URL",
        "VERCEL_URL",
        "ADMIN_EMAIL",
        "ADMIN_NAME",
        "APP_ENCRYPTION_KEY",
        "APP_HEALTH_TOKEN",
        "APP_TIMEZONE",
        "SESSION_TTL_HOURS",
        "LOGIN_MAX_ATTEMPTS",
        "LOGIN_WINDOW_MINUTES",
        "LOGIN_BLOCK_MINUTES",
        "DEMO_MODE",
        "PROVIDER_MODE",
        "MOCK_PROVIDERS",
        "SEND_LIVE",
        "MOCK_PROVIDER_BEHAVIOR",
        "TELEGRAM_ENABLED",
        "WHATSAPP_ENABLED",
        "SHOPEE_APP_ID",
        "SHOPEE_APP_SECRET",
        "SHOPEE_AFFILIATE_ID",
        "SHOPEE_API_BASE_URL",
        "PRODUCT_IMPORT_TIMEOUT_MS",
        "PRODUCT_IMPORT_CACHE_SECONDS",
        "PRODUCT_IMAGE_MAX_BYTES",
        "WORKER_API_URL",
        "WORKER_API_TOKEN"
      ]
    },
    "test": { "dependsOn": ["build"], "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": { "cache": false, "persistent": true },
    "generate": { "cache": false },
    "migrate:dev": { "cache": false }
  }
}
